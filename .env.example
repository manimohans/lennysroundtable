# =============================================================================
# LLM Configuration (required)
# =============================================================================
# All providers use OpenAI-compatible API. Choose ONE of the following:

# --- Option 1: Ollama (local, free) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=not-needed

# --- Option 2: LM Studio (local, free) ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=not-needed

# --- Option 3: OpenAI (cloud, paid) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-api-key-here

# =============================================================================
# Embedding Configuration (for ingestion)
# =============================================================================
# Used when running: uv run python -m roundtable.ingest

# --- Option 1: Ollama (default, local, free) ---
# Requires Ollama running with the embedding model pulled
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
# OLLAMA_BASE_URL=http://localhost:11434  # override if Ollama is on a different host

# --- Option 2: OpenAI (cloud, no Ollama required) ---
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small  # default when EMBEDDING_PROVIDER=openai

# =============================================================================
# Transcript Sync (optional - only needed to fetch new transcripts)
# =============================================================================
# Get a token at: https://www.dropbox.com/developers/apps
# DROPBOX_ACCESS_TOKEN=your_dropbox_token_here
