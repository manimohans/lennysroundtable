# Template for Streamlit secrets.
#
# LOCAL TESTING:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   Edit secrets.toml with your values (it is git-ignored).
#
# STREAMLIT CLOUD:
#   Go to your app → Settings → Secrets and paste these key=value pairs.

# === LLM provider (required for the hosted demo) ===
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL    = "gpt-4o-mini"
LLM_API_KEY  = "sk-..."

# === Embeddings (required for the hosted demo) ===
EMBEDDING_PROVIDER = "openai"
OPENAI_API_KEY     = "sk-..."

# === Pre-built vector DB (required for the hosted demo) ===
# Build and upload with: python scripts/upload_chroma.py --repo-id YOUR_REPO
HF_REPO_ID = "your-username/lennysroundtable-chroma"
